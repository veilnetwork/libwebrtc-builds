+  // The same windowed sinc filter is used for short clock-domain conversions.
+  static void Resample(const int16_t* input,
+                       uint32_t input_frames,
+                       uint16_t channels,
+                       uint32_t output_frames,
+                       double nominal_frames,
+                       double first,
+                       int16_t* output) {
+    constexpr int filter_radius = 8;
+    const double stride = input_frames / nominal_frames;
+    const double cutoff = (std::min)(1.0, 1.0 / stride);
+    constexpr double kPi = 3.14159265358979323846;
+    for (uint32_t frame = 0; frame < output_frames; ++frame) {
+      const double center = (first + frame) * stride;
+      const int floor = static_cast<int>(center);
+      const int begin = (std::max)(0, floor - filter_radius + 1);
+      const int end = (std::min)(static_cast<int>(input_frames),
+                                 floor + filter_radius + 1);
+      // Clip the filter to this packet. Samples on the far side of a
+      // discontinuity must never take part in reconstruction.
+      double weight_sum = 0;
+      double weights[2 * filter_radius];
+      for (int tap = begin; tap < end; ++tap) {
+        const double x = kPi * (tap - center);
+        const double weight = Sinc(cutoff * x) * Sinc(x / filter_radius);
+        weights[tap - begin] = weight;
+        weight_sum += weight;
+      }
+      for (uint16_t channel = 0; channel < channels; ++channel) {
+        double value = 0;
+        for (int tap = begin; tap < end; ++tap) {
+          value += weights[tap - begin] *
+                   input[static_cast<size_t>(tap) * channels +
+                                    channel];
+        }
+        if (std::abs(weight_sum) > 1e-8) value /= weight_sum;
+        output[size_t{frame} * channels + channel] =
+            static_cast<int16_t>(std::round(std::clamp(value, -32768., 32767.)));
+      }
+    }
+  }
