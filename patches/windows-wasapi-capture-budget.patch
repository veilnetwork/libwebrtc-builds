diff --git a/modules/audio_device/win/wasapi_capture_budget.h b/modules/audio_device/win/wasapi_capture_budget.h
new file mode 100644
index 0000000..19f8297
--- /dev/null
+++ b/modules/audio_device/win/wasapi_capture_budget.h
@@ -0,0 +1,182 @@
+#ifndef MODULES_AUDIO_DEVICE_WIN_WASAPI_CAPTURE_BUDGET_H_
+#define MODULES_AUDIO_DEVICE_WIN_WASAPI_CAPTURE_BUDGET_H_
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+#include "modules/audio_device/win/wasapi_capture_retimer.h"
+
+namespace webrtc {
+
+// Account for capture against a single QPC epoch. The hardware rate filter can
+// shorten or lengthen an individual packet, and gaps can remove complete
+// packets. Keep early PCM queued, and represent a missing interval only when
+// both the original device position and timestamp support it.
+class WasapiCaptureBudget {
+ public:
+  using Packet = WasapiCaptureRetimer::Packet;
+
+  WasapiCaptureBudget(uint32_t sample_rate, uint16_t channels)
+      : rate_(sample_rate), channels_(channels), retimer_(sample_rate, channels) {}
+
+  void Prepare(uint32_t max_input_frames) {
+    retimer_.Prepare(max_input_frames);
+    const uint32_t storage_frames = QueueLimit() + 2 * max_input_frames +
+        2 * retimer_.max_output_frames() + FramesForMilliseconds(kMaxFillMs);
+    queue_.reserve(size_t{storage_frames} * channels_);
+    chunks_.reserve(storage_frames);
+    compressed_.resize(size_t{QueueLimit()} * channels_);
+    silence_.resize(size_t{FramesForMilliseconds(kMaxFillMs)} * channels_);
+  }
+
+  uint32_t max_output_frames() const { return retimer_.max_output_frames(); }
+  uint32_t queued_frames() const { return static_cast<uint32_t>(queue_.size() / channels_); }
+  uint64_t filled_frames() const { return filled_frames_; }
+  uint64_t compressed_frames() const { return compressed_frames_; }
+
+  template <typename Emit>
+  void Push(const int16_t* samples, Packet packet, uint64_t now, Emit&& emit) {
+    if (now == 0 || (last_now_ && now < last_now_)) {
+      // A clock restart invalidates the old deadline and gap evidence.
+      Drain(queued_frames(), emit);
+      read_epoch_ = capture_epoch_ = 0;
+      previous_ = {};
+    }
+    last_now_ = now;
+    if (!read_epoch_ && now && packet.valid && packet.qpc <= now) {
+      read_epoch_ = now;
+      capture_epoch_ = packet.qpc;
+      emitted_at_epoch_ = emitted_;
+    }
+
+    const uint64_t ceiling = read_epoch_
+        ? emitted_at_epoch_ + ElapsedFrames(now - read_epoch_) +
+              FramesForMilliseconds(kLeadMs)
+        : (std::numeric_limits<uint64_t>::max)();
+    uint32_t gap = ConfirmedGap(packet);
+    retimer_.Push(samples, packet, [&](const int16_t* pcm, Packet processed) {
+      // A previous packet held by the retimer belongs before this gap.
+      if (gap && (!processed.valid || processed.qpc >= packet.qpc)) {
+        AppendGap(packet, gap, ceiling);
+        gap = 0;
+      }
+      Append(pcm, processed);
+    });
+    if (gap) AppendGap(packet, gap, ceiling);
+    previous_ = packet;
+
+    const uint64_t possible = ceiling > emitted_ ? ceiling - emitted_ : 0;
+    Drain(static_cast<uint32_t>((std::min)(possible, uint64_t{queued_frames()})),
+          emit);
+    if (queued_frames() > QueueLimit()) CompressQueue();
+  }
+
+ private:
+  static constexpr uint64_t kTicksPerSecond = 10'000'000;
+  static constexpr uint32_t kLeadMs = 20;
+  static constexpr uint32_t kQueueMs = 70;
+  static constexpr uint32_t kMaxGapMs = 500;
+  static constexpr uint32_t kMaxFillMs = 250;
+
+  uint32_t FramesForMilliseconds(uint32_t ms) const { return rate_ * ms / 1000; }
+  uint32_t QueueLimit() const { return FramesForMilliseconds(kQueueMs); }
+
+  uint64_t ElapsedFrames(uint64_t ticks) const {
+    return ticks / kTicksPerSecond * rate_ +
+           ticks % kTicksPerSecond * rate_ / kTicksPerSecond;
+  }
+
+  uint32_t ConfirmedGap(const Packet& packet) const {
+    if (!capture_epoch_ || !previous_.valid || !packet.valid ||
+        previous_.position > (std::numeric_limits<uint64_t>::max)() - previous_.frames ||
+        packet.qpc <= previous_.qpc ||
+        packet.qpc - previous_.qpc > kMaxGapMs * 10'000) {
+      return 0;
+    }
+    const uint64_t end = previous_.position + previous_.frames;
+    const auto expected = ElapsedFrames(packet.qpc - previous_.qpc);
+    if (packet.position <= end || expected <= previous_.frames) return 0;
+    return static_cast<uint32_t>((std::min)({
+        packet.position - end, expected - previous_.frames,
+        uint64_t{FramesForMilliseconds(kMaxFillMs)}}));
+  }
+
+  void AppendGap(const Packet& packet, uint32_t gap, uint64_t ceiling) {
+    if (packet.qpc < capture_epoch_) return;
+    const uint64_t eligible = (std::min)(
+        ceiling, emitted_at_epoch_ + ElapsedFrames(packet.qpc - capture_epoch_));
+    const uint64_t known = emitted_ + queued_frames();
+    if (eligible <= known) return;
+    const auto frames = static_cast<uint32_t>((std::min)(eligible - known, uint64_t{gap}));
+    const uint64_t start = packet.qpc - uint64_t{frames} * kTicksPerSecond / rate_;
+    Append(silence_.data(), {packet.position - frames, start, frames, true, true});
+    filled_frames_ += frames;
+  }
+
+  void Append(const int16_t* pcm, Packet packet) {
+    if (!packet.frames) return;
+    queue_.insert(queue_.end(), pcm, pcm + size_t{packet.frames} * channels_);
+    chunks_.push_back(packet);
+  }
+
+  template <typename Emit>
+  void Drain(uint32_t frames, Emit& emit) {
+    uint32_t drained = 0;
+    size_t chunks_drained = 0;
+    while (drained < frames) {
+      Packet& head = chunks_[chunks_drained];
+      const uint32_t n = (std::min)({frames - drained, head.frames, max_output_frames()});
+      Packet piece = head;
+      piece.frames = n;
+      piece.valid = piece.valid && piece.qpc <= last_now_;
+      emit(queue_.data() + size_t{drained} * channels_, piece);
+      drained += n;
+      if (n == head.frames) {
+        ++chunks_drained;
+      } else {
+        head.frames -= n;
+        head.position += n;
+        head.qpc += uint64_t{n} * kTicksPerSecond / rate_;
+        head.discontinuity = false;
+      }
+    }
+    queue_.erase(queue_.begin(), queue_.begin() + size_t{drained} * channels_);
+    chunks_.erase(chunks_.begin(), chunks_.begin() + chunks_drained);
+    emitted_ += drained;
+  }
+
+  void CompressQueue() {
+    const uint32_t input = queued_frames();
+    const uint32_t output = QueueLimit();
+    // Keep the pending PCM in order while shortening the excess. The
+    // resampled span does not supply a fresh device capture timestamp.
+    WasapiCaptureRetimer::Resample(queue_.data(), input, channels_, output,
+                                  output, 0., compressed_.data());
+    queue_.assign(compressed_.begin(), compressed_.end());
+    chunks_.assign(1, Packet{0, 0, output, false, true});
+    compressed_frames_ += input - output;
+  }
+
+  const uint32_t rate_;
+  const uint16_t channels_;
+  WasapiCaptureRetimer retimer_;
+  Packet previous_;
+  uint64_t last_now_ = 0;
+  uint64_t read_epoch_ = 0;
+  uint64_t capture_epoch_ = 0;
+  uint64_t emitted_at_epoch_ = 0;
+  uint64_t emitted_ = 0;
+  uint64_t filled_frames_ = 0;
+  uint64_t compressed_frames_ = 0;
+  std::vector<int16_t> queue_;
+  std::vector<Packet> chunks_;
+  std::vector<int16_t> compressed_;
+  std::vector<int16_t> silence_;
+};
+
+}  // namespace webrtc
+
+#endif  // MODULES_AUDIO_DEVICE_WIN_WASAPI_CAPTURE_BUDGET_H_
