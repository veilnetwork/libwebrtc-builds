diff --git a/modules/audio_device/win/wasapi_capture_timeline.h b/modules/audio_device/win/wasapi_capture_timeline.h
new file mode 100644
index 0000000..c931f59
--- /dev/null
+++ b/modules/audio_device/win/wasapi_capture_timeline.h
@@ -0,0 +1,86 @@
+#ifndef MODULES_AUDIO_DEVICE_WIN_WASAPI_CAPTURE_TIMELINE_H_
+#define MODULES_AUDIO_DEVICE_WIN_WASAPI_CAPTURE_TIMELINE_H_
+
+#include <cstdint>
+#include <limits>
+#include <optional>
+
+namespace webrtc {
+
+// Track the first sample while WASAPI packets are gathered into the 10 ms
+// blocks expected by AudioTransport. A block spanning a gap still carries
+// the original PCM, but has no single trustworthy capture timestamp.
+class WasapiCaptureTimeline {
+ public:
+  explicit WasapiCaptureTimeline(uint32_t sample_rate_hz)
+      : sample_rate_hz_(sample_rate_hz) {}
+
+  void Append(uint64_t position,
+              uint32_t frames,
+              uint64_t qpc_100ns,
+              uint64_t now_100ns,
+              uint32_t buffered_frames,
+              bool timestamps_valid,
+              bool discontinuity) {
+    packet_offset_ = buffered_frames;
+    now_100ns_ = now_100ns;
+    const bool valid =
+        timestamps_valid && qpc_100ns > 0 && qpc_100ns <= now_100ns &&
+        qpc_100ns <= kMaxQpc100ns &&
+        position <= (std::numeric_limits<uint64_t>::max)() - frames &&
+        (!last_qpc_100ns_ || qpc_100ns > *last_qpc_100ns_);
+    if (!valid || discontinuity || expected_position_ != position) {
+      buffered_timestamp_ns_.reset();
+    }
+    if (!valid) {
+      packet_timestamp_ns_.reset();
+      expected_position_.reset();
+      last_qpc_100ns_.reset();
+      return;
+    }
+    packet_timestamp_ns_ = static_cast<int64_t>(qpc_100ns * 100);
+    expected_position_ = position + frames;
+    last_qpc_100ns_ = qpc_100ns;
+  }
+
+  std::optional<int64_t> CaptureTimeNs(uint32_t offset) const {
+    const bool in_packet = offset >= packet_offset_;
+    const auto anchor =
+        in_packet ? packet_timestamp_ns_ : buffered_timestamp_ns_;
+    if (!anchor || sample_rate_hz_ == 0) {
+      return std::nullopt;
+    }
+    const uint32_t sample_offset = in_packet ? offset - packet_offset_ : offset;
+    const int64_t extra_ns = int64_t{sample_offset} * 1'000'000'000 /
+                             sample_rate_hz_;
+    if (*anchor > (std::numeric_limits<int64_t>::max)() - extra_ns) {
+      return std::nullopt;
+    }
+    const int64_t stamp_ns = *anchor + extra_ns;
+    if (static_cast<uint64_t>(stamp_ns / 100) > now_100ns_) {
+      return std::nullopt;
+    }
+    return stamp_ns;
+  }
+
+  void Retain(uint32_t consumed_frames, uint32_t remaining_frames) {
+    buffered_timestamp_ns_ =
+        remaining_frames > 0 ? CaptureTimeNs(consumed_frames) : std::nullopt;
+  }
+
+ private:
+  static constexpr uint64_t kMaxQpc100ns =
+      (std::numeric_limits<int64_t>::max)() / 100;
+
+  const uint32_t sample_rate_hz_;
+  uint32_t packet_offset_ = 0;
+  uint64_t now_100ns_ = 0;
+  std::optional<uint64_t> expected_position_;
+  std::optional<uint64_t> last_qpc_100ns_;
+  std::optional<int64_t> packet_timestamp_ns_;
+  std::optional<int64_t> buffered_timestamp_ns_;
+};
+
+}  // namespace webrtc
+
+#endif  // MODULES_AUDIO_DEVICE_WIN_WASAPI_CAPTURE_TIMELINE_H_
