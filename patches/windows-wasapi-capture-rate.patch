diff --git a/modules/audio_device/win/wasapi_capture_retimer.h b/modules/audio_device/win/wasapi_capture_retimer.h
new file mode 100644
index 0000000..fda52e2
--- /dev/null
+++ b/modules/audio_device/win/wasapi_capture_retimer.h
@@ -0,0 +1,213 @@
+#ifndef MODULES_AUDIO_DEVICE_WIN_WASAPI_CAPTURE_RETIMER_H_
+#define MODULES_AUDIO_DEVICE_WIN_WASAPI_CAPTURE_RETIMER_H_
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <vector>
+
+namespace webrtc {
+
+// WASAPI positions measure captured samples; QPC measures elapsed wall time.
+// Correct sustained disagreement between them before Opus creates RTP time.
+// Normal capture is passed through without waiting for the following packet.
+class WasapiCaptureRetimer {
+ public:
+  struct Packet {
+    uint64_t position = 0;
+    uint64_t qpc = 0;  // WASAPI QPC in 100 ns units.
+    uint32_t frames = 0;
+    bool valid = false;
+    bool discontinuity = false;
+  };
+
+  WasapiCaptureRetimer(uint32_t sample_rate, uint16_t channels)
+      : sample_rate_(sample_rate), channels_(channels) {}
+
+  void Prepare(uint32_t max_input_frames) {
+    pending_samples_.resize(size_t{max_input_frames} * channels_);
+    corrected_samples_.resize(size_t{max_output_frames()} * channels_);
+  }
+
+  uint32_t max_output_frames() const {
+    return (sample_rate_ * 60 + 999) / 1000;
+  }
+
+  template <typename Emit>
+  void Push(const int16_t* samples, Packet packet, Emit&& emit) {
+    const bool contiguous = Contiguous(previous_, packet);
+    if (!contiguous) {
+      if (pending_.frames > 0) {
+        emit(pending_samples_.data(), pending_);
+        pending_ = {};
+      }
+      // Engagement still requires sustained contiguous capture. While
+      // correcting, short gaps do not erase evidence that the device has
+      // returned to a nominal rate. Broken intervals are never measured.
+      if (!correcting_ || !packet.valid || !last_rate_qpc_ ||
+          packet.qpc <= previous_.qpc ||
+          packet.qpc - last_rate_qpc_ > kMaxInterval) {
+        rate_qpc_ = 0;
+        rate_frames_ = 0;
+        last_rate_qpc_ = 0;
+        direction_ = 0;
+        windows_ = 0;
+      }
+      packet.discontinuity = true;
+      epoch_qpc_ = 0;
+    } else {
+      const bool was_correcting = correcting_;
+      ObserveRate(packet);
+      if (was_correcting && !correcting_ && pending_.frames > 0) {
+        Correct(packet.qpc, emit);
+        pending_ = {};
+        // Subsequent samples use the hardware timestamp and cadence again.
+        packet.discontinuity = true;
+      }
+    }
+    previous_ = packet;
+
+    if (!correcting_ || !packet.valid) {
+      emit(samples, packet);
+      return;
+    }
+
+    if (pending_.frames != 0) {
+      Correct(packet.qpc, emit);
+    } else {
+      // A block straddling the correction boundary has no single capture
+      // timestamp. No samples are discarded at the boundary.
+      packet.discontinuity = true;
+      epoch_qpc_ = packet.qpc;
+    }
+    std::copy_n(samples, size_t{packet.frames} * channels_,
+                pending_samples_.data());
+    pending_ = packet;
+  }
+
+ private:
+  static constexpr uint64_t kQpcPerSecond = 10'000'000;
+  static constexpr uint64_t kMaxInterval = 600'000;  // 60 ms.
+  static constexpr uint64_t kRateWindow = 2'000'000;  // 200 ms.
+  static constexpr int kRequiredWindows = 3;
+  static constexpr int kFilterRadius = 8;
+
+  static bool Contiguous(const Packet& before, const Packet& after) {
+    return before.valid && after.valid && !after.discontinuity &&
+           before.position <=
+               (std::numeric_limits<uint64_t>::max)() - before.frames &&
+           after.position == before.position + before.frames &&
+           after.qpc > before.qpc && after.qpc - before.qpc <= kMaxInterval;
+  }
+
+  void ObserveRate(const Packet& packet) {
+    last_rate_qpc_ = packet.qpc;
+    rate_qpc_ += packet.qpc - previous_.qpc;
+    rate_frames_ += previous_.frames;
+    if (rate_qpc_ < kRateWindow) return;
+    const double expected = rate_qpc_ * static_cast<double>(sample_rate_) /
+                            kQpcPerSecond;
+    const double actual = rate_frames_;
+    rate_qpc_ = 0;
+    rate_frames_ = 0;
+    if (correcting_) {
+      // Require a narrower band to return to pass-through. A clock close to
+      // the engagement threshold should not alternate between modes.
+      const bool nominal = actual >= 0.95 * expected && actual <= 1.05 * expected;
+      windows_ = nominal ? windows_ + 1 : 0;
+      if (windows_ >= kRequiredWindows) {
+        correcting_ = false;
+        windows_ = 0;
+      }
+      return;
+    }
+    const int direction = actual > 1.10 * expected ? 1 :
+                          actual < 0.90 * expected ? -1 : 0;
+    windows_ = direction == 0 ? 0 : direction == direction_ ? windows_ + 1 : 1;
+    direction_ = direction;
+    if (windows_ >= kRequiredWindows) {
+      correcting_ = true;
+      windows_ = 0;
+      direction_ = 0;
+    }
+  }
+
+  uint64_t SampleIndex(uint64_t qpc) const {
+    const uint64_t elapsed = qpc - epoch_qpc_;
+    return elapsed / kQpcPerSecond * sample_rate_ +
+           (elapsed % kQpcPerSecond * sample_rate_ + kQpcPerSecond - 1) /
+               kQpcPerSecond;
+  }
+
+  static double Sinc(double radians) {
+    return std::abs(radians) < 1e-8 ? 1.0 : std::sin(radians) / radians;
+  }
+
+  template <typename Emit>
+  void Correct(uint64_t end_qpc, Emit& emit) {
+    const uint64_t elapsed = pending_.qpc - epoch_qpc_;
+    const uint64_t phase = elapsed % kQpcPerSecond * sample_rate_ % kQpcPerSecond;
+    const uint64_t to_grid = phase == 0 ? 0 : kQpcPerSecond - phase;
+    const auto output_frames = static_cast<uint32_t>(
+        SampleIndex(end_qpc) - SampleIndex(pending_.qpc));
+    if (output_frames == 0) return;
+    const double nominal_frames =
+        (end_qpc - pending_.qpc) * static_cast<double>(sample_rate_) / kQpcPerSecond;
+    const double stride = pending_.frames / nominal_frames;
+    const double cutoff = (std::min)(1.0, 1.0 / stride);
+    const double first = to_grid / double{kQpcPerSecond};
+    constexpr double kPi = 3.14159265358979323846;
+    for (uint32_t frame = 0; frame < output_frames; ++frame) {
+      const double center = (first + frame) * stride;
+      const int floor = static_cast<int>(center);
+      const int begin = (std::max)(0, floor - kFilterRadius + 1);
+      const int end = (std::min)(static_cast<int>(pending_.frames),
+                                 floor + kFilterRadius + 1);
+      // Clip the filter to this packet. Samples on the far side of a
+      // discontinuity must never take part in reconstruction.
+      double weight_sum = 0;
+      double weights[2 * kFilterRadius];
+      for (int tap = begin; tap < end; ++tap) {
+        const double x = kPi * (tap - center);
+        const double weight = Sinc(cutoff * x) * Sinc(x / kFilterRadius);
+        weights[tap - begin] = weight;
+        weight_sum += weight;
+      }
+      for (uint16_t channel = 0; channel < channels_; ++channel) {
+        double value = 0;
+        for (int tap = begin; tap < end; ++tap) {
+          value += weights[tap - begin] *
+                   pending_samples_[static_cast<size_t>(tap) * channels_ +
+                                    channel];
+        }
+        if (std::abs(weight_sum) > 1e-8) value /= weight_sum;
+        corrected_samples_[size_t{frame} * channels_ + channel] =
+            static_cast<int16_t>(std::round(std::clamp(value, -32768., 32767.)));
+      }
+    }
+    Packet corrected = pending_;
+    corrected.frames = output_frames;
+    corrected.qpc += to_grid / sample_rate_;
+    emit(corrected_samples_.data(), corrected);
+  }
+
+  const uint32_t sample_rate_;
+  const uint16_t channels_;
+  Packet previous_;
+  Packet pending_;
+  uint64_t last_rate_qpc_ = 0;
+  uint64_t rate_qpc_ = 0;
+  uint64_t rate_frames_ = 0;
+  uint64_t epoch_qpc_ = 0;
+  int direction_ = 0;
+  int windows_ = 0;
+  bool correcting_ = false;
+  std::vector<int16_t> pending_samples_;
+  std::vector<int16_t> corrected_samples_;
+};
+
+}  // namespace webrtc
+
+#endif  // MODULES_AUDIO_DEVICE_WIN_WASAPI_CAPTURE_RETIMER_H_
