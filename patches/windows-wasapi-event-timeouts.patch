+// A slow endpoint can outlive the normal shutdown interval. Its thread
+// still owns this ADM's callbacks, critical section and WASAPI interfaces.
+// Report the delay, then wait with the ADM lock released before freeing any
+// of them. The handle remains owned by StopRecording/StopPlayout throughout.
+void JoinAudioThread(HANDLE thread, const char* direction) {
+  DWORD result = WaitForSingleObject(thread, 2000);
+  if (result == WAIT_TIMEOUT) {
+    RTC_LOG(LS_WARNING) << "waiting for the WASAPI " << direction
+                        << " thread to stop";
+    result = WaitForSingleObject(thread, INFINITE);
+  }
+  RTC_CHECK_EQ(result, WAIT_OBJECT_0);
+}
+
+// Use event-driven audio normally. If a driver misses a readiness event,
+// check the buffer at the 10 ms audio block cadence until events resume.
+// Back off polling if the endpoint stays empty.
+class AudioNotificationWait {
+ public:
+  void Start(REFERENCE_TIME device_period) {
+    // Leave three device periods for a healthy notification, with at least
+    // 50 ms for scheduler jitter. Missing or slow period data keeps 500 ms.
+    constexpr REFERENCE_TIME kMaxPeriod =
+        kDefaultNotificationWaitMs * REFTIMES_PER_MILLISEC / 3;
+    if (device_period > 0 && device_period < kMaxPeriod) {
+      const DWORD wait_ms = static_cast<DWORD>(
+          (3 * device_period + REFTIMES_PER_MILLISEC - 1) / REFTIMES_PER_MILLISEC);
+      notification_wait_ms_ = wait_ms < 50 ? 50 : wait_ms;
+    }
+    last_activity_ms_ = GetTickCount64();
+  }
+
+  DWORD timeout_ms() const {
+    if (idle_) return kIdlePollMs;
+    return polling_ ? 10 : notification_wait_ms_;
+  }
+
+  bool Observe(DWORD wait_result, bool processed_audio) {
+    polling_ = wait_result == WAIT_TIMEOUT;
+    const ULONGLONG now_ms = GetTickCount64();
+    if (!polling_ || processed_audio) {
+      last_activity_ms_ = now_ms;
+      idle_ = false;
+      return false;
+    }
+    if (!idle_ && now_ms - last_activity_ms_ >= kIdleAfterMs) {
+      // A temporarily empty endpoint can recover without being reopened.
+      // Keep waiting for real readiness and back off the fallback polling.
+      idle_ = true;
+      return true;
+    }
+    return false;
+  }
+
+ private:
+  static constexpr DWORD kDefaultNotificationWaitMs = 500;
+  static constexpr DWORD kIdlePollMs = 100;
+  static constexpr ULONGLONG kIdleAfterMs = 2000;
+  DWORD notification_wait_ms_ = kDefaultNotificationWaitMs;
+  ULONGLONG last_activity_ms_ = 0;
+  bool polling_ = false;
+  bool idle_ = false;
+};
